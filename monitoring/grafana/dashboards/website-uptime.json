{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Current Website Status",
      "type": "stat",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN (Outage)" }, "1": { "color": "green", "text": "UP (Operational)" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "targets": [{ "expr": "probe_success", "legendFormat": "{{instance}}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Uptime SLA (Availability)",
      "type": "gauge",
      "options": {
        "min": 0,
        "max": 100,
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 99 }] }
        }
      },
      "targets": [{ "expr": "(avg(avg_over_time(probe_success[30m])) * 100) or (avg(probe_success) * 100)", "legendFormat": "Uptime SLA %" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Probe Response Latency",
      "type": "stat",
      "options": { "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3 }
      },
      "targets": [{ "expr": "probe_duration_seconds", "legendFormat": "{{instance}}" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Total Probes Completed",
      "type": "stat",
      "options": { "colorMode": "value" },
      "targets": [{ "expr": "sum(count_over_time(probe_success[24h])) or sum(count_over_time(probe_success[1h]))", "legendFormat": "Total Probes" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "title": "Website Availability & Outage History (Timeline)",
      "type": "state-timeline",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ]
        }
      },
      "targets": [{ "expr": "probe_success or website_probe_success", "legendFormat": "Endpoint: {{instance}}" }]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["uptime", "monitoring", "grafana", "prometheus"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Website Uptime & Downtime Monitoring Dashboard",
  "uid": "website-uptime-sla"
}
